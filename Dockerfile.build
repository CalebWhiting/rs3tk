# Build the rs3tk Electron AppImage in a clean environment.
#
# Build:   docker build -f Dockerfile.build -t rs3tk-build .
# Run:     docker run --rm -v "$PWD/packages/electron/dist:/out" rs3tk-build
# Shell:   docker run --rm -it --entrypoint bash rs3tk-build
#
# What this does:
#   1. Installs system deps (X11, fakeroot, etc.) needed by Electron builder
#   2. Runs the full setup: uv sync + pnpm install
#   3. Builds: pnpm build:bridge → electron-vite build → AppImage

FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ── system packages ────────────────────────────────────────────────
# build-essential  — C/C++ compiler (native Node modules, PyInstaller)
# fakeroot/dpkg    — AppImage packaging
# libX*/libgtk*    — Electron runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
        git \
        python3 python3-venv python3-dev \
        fakeroot dpkg \
        libx11-6 libxext6 libxss1 libxtst6 \
        libnss3 \
        libatk1.0-0 libatk-bridge2.0-0 \
        libcups2 libdrm2 libgbm1 \
        libgtk-3-0 libasound2t64 \
    && rm -rf /var/lib/apt/lists/*

# ── uv (Python package manager) ───────────────────────────────────
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# ── Node.js 20.x + pnpm ──────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g pnpm \
    && rm -rf /var/lib/apt/lists/*

# ── copy the repo ─────────────────────────────────────────────────
WORKDIR /app
COPY . .

# ── run the full setup + build ────────────────────────────────────
RUN uv sync && pnpm install

# Make venv tools available on PATH (for build-bridge.sh)
ENV PATH="/app/.venv/bin:${PATH}"

RUN pnpm build:linux

# ── output ────────────────────────────────────────────────────────
# The AppImage lands in packages/electron/dist/.
# Mount that directory to retrieve it:
#   docker run --rm -v "$PWD/packages/electron/dist:/out" rs3tk-build
VOLUME /app/packages/electron/dist
